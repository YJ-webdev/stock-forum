generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TradeType {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

enum PredictionDirection {
  BULL
  BEAR
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  VOID
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  nationality   String?
  language      String    @default("en")
  role          Role      @default(USER)

  accounts     Account[]
  sessions     Session[]
  replies      Reply[]
  comments     Comment[]
  replyLikes   ReplyLike[]
  commentLikes CommentLike[]
  balance      AccountBalance?
  trades       Trade[]
  positions    PortfolioPosition[]
  watchlist    Watchlist[]
  predictions  Prediction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Comment {
  id        String   @id @default(cuid())
  content   Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  predictionId String?     @unique
  prediction   Prediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  assets  CommentAsset[]
  replies Reply[]
  likes   CommentLike[]
}

model Prediction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol String
  asset  MarketAsset @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  direction PredictionDirection
  pointsBet Int

  predictionPrice Decimal  @db.Decimal(18, 4)
  sessionDate     DateTime

  closingPrice Decimal?         @db.Decimal(18, 4)
  status       PredictionStatus @default(PENDING)
  pointsChange Int?

  // Snapshot of User.nationality when prediction is submitted
  nationality String?

  // Optional comment attached to this prediction
  comment Comment?

  createdAt DateTime  @default(now())
  settledAt DateTime?

  @@unique([userId, symbol, sessionDate])
  @@index([symbol, sessionDate])
  @@index([userId, createdAt])
  @@index([nationality, symbol, sessionDate])
  @@index([status])
}

model CommentAsset {
  commentId   String
  assetSymbol String

  comment Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  asset   MarketAsset @relation(fields: [assetSymbol], references: [symbol], onDelete: Cascade)

  @@id([commentId, assetSymbol])
  @@index([assetSymbol])
}

model Reply {
  id      String @id @default(cuid())
  content String

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  likes ReplyLike[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commentId, createdAt])
  @@index([authorId, createdAt])
}

model CommentLike {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model ReplyLike {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  replyId String
  reply   Reply  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, replyId])
  @@index([replyId])
}

model MarketAsset {
  id            String  @id @default(cuid())
  symbol        String  @unique
  displaySymbol String?
  name          String
  category      String
  assetType     String  @default("index")
  timezone      String  @default("UTC")
  logoUrl       String?

  lastPrice     Decimal @default(0.0) @db.Decimal(18, 4)
  change        Decimal @default(0.0) @db.Decimal(18, 4)
  changePercent Decimal @default(0.0) @db.Decimal(10, 4)
  high          Decimal @default(0.0) @db.Decimal(18, 4)
  low           Decimal @default(0.0) @db.Decimal(18, 4)
  volume        Decimal @default(0.0) @db.Decimal(18, 2)

  trades         Trade[]
  positions      PortfolioPosition[]
  watchlistItems Watchlist[]
  comments       CommentAsset[]
  predictions    Prediction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountBalance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cash Decimal @default(10000.0) @db.Decimal(18, 2)
  pnl  Decimal @default(0.0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioPosition {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol String
  asset  MarketAsset @relation(fields: [symbol], references: [symbol])

  quantity Decimal @default(0.0) @db.Decimal(18, 8)
  avgCost  Decimal @default(0.0) @db.Decimal(18, 4)

  updatedAt DateTime @updatedAt

  @@unique([userId, symbol])
}

model Trade {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol String
  asset  MarketAsset @relation(fields: [symbol], references: [symbol])

  type   TradeType
  status TradeStatus @default(OPEN)

  quantity   Decimal  @db.Decimal(18, 8)
  entryPrice Decimal  @db.Decimal(18, 4)
  exitPrice  Decimal? @db.Decimal(18, 4)
  pnl        Decimal? @db.Decimal(18, 2)

  createdAt DateTime  @default(now())
  closedAt  DateTime?

  @@index([userId, status])
}

model Watchlist {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol String
  asset  MarketAsset @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, symbol])
}
