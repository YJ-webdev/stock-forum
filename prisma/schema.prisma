generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum TradeType {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  country       String?         @default("US")
  role          Role            @default(USER)
  
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  balance       AccountBalance?
  trades        Trade[]
  positions     PortfolioPosition[]
  watchlist     Watchlist[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id          String        @id @default(cuid())
  title       String
  content     Json
  stockTicker String?

  viewCount   Int           @default(0)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  author      User          @relation(fields: [authorId], references: [id])
  authorId    String

  categoryId  String
  category    ForumCategory @relation(fields: [categoryId], references: [id])

  comments    Comment[]
  likes       Like[]

  @@index([categoryId, createdAt])
  @@index([authorId, createdAt])
  @@index([stockTicker, createdAt])
}

model Comment {
  id        String   @id @default(cuid())
  content   String

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model ForumCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  posts       Post[]
  createdAt   DateTime @default(now())
}

model MarketAsset {
  id            String              @id @default(cuid())
  symbol        String              @unique
  displaySymbol String?
  name          String
  category      String
  assetType     String              @default("index")
  timezone      String              @default("UTC")
  logoUrl       String?
  
  // Use Decimal for high precision values
  lastPrice     Decimal             @default(0.0) @db.Decimal(18, 4)
  change        Decimal             @default(0.0) @db.Decimal(18, 4)
  changePercent Decimal             @default(0.0) @db.Decimal(10, 4)
  high          Decimal             @default(0.0) @db.Decimal(18, 4)
  low           Decimal             @default(0.0) @db.Decimal(18, 4)
  volume        Decimal             @default(0.0) @db.Decimal(18, 2)
  
  trades        Trade[]
  positions     PortfolioPosition[]
  watchlistItems Watchlist[]

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model AccountBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cash      Decimal  @default(10000.0) @db.Decimal(18, 2)
  pnl       Decimal  @default(0.0)     @db.Decimal(18, 2)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioPosition {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  symbol      String
  asset       MarketAsset @relation(fields: [symbol], references: [symbol])
  
  quantity    Decimal     @default(0.0) @db.Decimal(18, 8)
  avgCost     Decimal     @default(0.0) @db.Decimal(18, 4)

  updatedAt   DateTime    @updatedAt

  @@unique([userId, symbol])
}

model Trade {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  symbol     String
  asset      MarketAsset @relation(fields: [symbol], references: [symbol])
  
  type       TradeType
  status     TradeStatus @default(OPEN)
  
  quantity   Decimal     @db.Decimal(18, 8)
  entryPrice Decimal     @db.Decimal(18, 4)
  exitPrice  Decimal?    @db.Decimal(18, 4)
  pnl        Decimal?    @db.Decimal(18, 2)
  
  createdAt  DateTime    @default(now())
  closedAt   DateTime?

  @@index([userId, status])
}

model Watchlist {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  symbol    String
  asset     MarketAsset @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  
  createdAt DateTime    @default(now())

  @@unique([userId, symbol])
}