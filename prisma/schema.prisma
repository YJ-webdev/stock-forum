generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum PredictionDirection {
  BULL
  BEAR
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  DRAW
  VOID
}

enum UserStatus {
  ACTIVE
  MUTED
  BANNED
}

enum ModerationActionType {
  MUTE_USER
  UNMUTE_USER
  BAN_USER
  UNBAN_USER
  HIDE_COMMENT
  RESTORE_COMMENT
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  nationality   String?
  language      String    @default("en")
  role          Role      @default(USER)

  status   UserStatus @default(ACTIVE)
  mutedAt  DateTime?
  bannedAt DateTime?

  moderationActionsReceived  ModerationAction[] @relation("ModerationTargetUser")
  moderationActionsPerformed ModerationAction[] @relation("ModerationModerator")

  accounts          Account[]
  sessions          Session[]
  replies           Reply[]
  comments          Comment[]
  replyLikes        ReplyLike[]
  commentLikes      CommentLike[]
  balance           AccountBalance?
  watchlist         Watchlist[]
  predictions       Prediction[]
  notifications     Notification[]
  pointBalance      PointBalance?
  pointTransactions PointTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Comment {
  id      String @id @default(cuid())
  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  editedAt    DateTime?
  withdrawnAt DateTime?
  moderatedAt DateTime?

  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  predictionId String?     @unique
  prediction   Prediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  assets  CommentAsset[]
  replies Reply[]
  likes   CommentLike[]

  moderationActions ModerationAction[]

  @@index([authorId, createdAt])
  @@index([withdrawnAt])
  @@index([moderatedAt])
}

model ModerationAction {
  id     String               @id @default(cuid())
  type   ModerationActionType
  reason String?

  moderatorId String
  moderator   User   @relation("ModerationModerator", fields: [moderatorId], references: [id], onDelete: Restrict)

  targetUserId String?
  targetUser   User?   @relation("ModerationTargetUser", fields: [targetUserId], references: [id], onDelete: SetNull)

  commentId String?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([targetUserId, createdAt])
  @@index([commentId, createdAt])
  @@index([moderatorId, createdAt])
  @@index([type, createdAt])
}

model Prediction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol String
  asset  MarketAsset @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  direction PredictionDirection

  pointsBet       Int
  referenceClose  Decimal  @db.Decimal(18, 4)
  settlementClose Decimal? @db.Decimal(18, 4)
  sessionDate     DateTime

  status       PredictionStatus @default(PENDING)
  pointsChange Int?

  nationality String?

  comment           Comment?
  notification      Notification[]
  pointTransactions PointTransaction[]

  createdAt DateTime  @default(now())
  settledAt DateTime?

  @@unique([userId, symbol, sessionDate])
  @@index([symbol, sessionDate])
  @@index([userId, createdAt])
  @@index([nationality, symbol, sessionDate])
  @@index([status])
}

model CommentAsset {
  commentId   String
  assetSymbol String

  comment Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  asset   MarketAsset @relation(fields: [assetSymbol], references: [symbol], onDelete: Cascade)

  @@id([commentId, assetSymbol])
  @@index([assetSymbol])
}

model Reply {
  id String @id @default(cuid())

  content String
  gifUrl  String?

  // Comment this reply belongs to
  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Author
  authorId String
  author   User   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  // Parent reply
  parentId String?
  parent   Reply?  @relation("ReplyThread", fields: [parentId], references: [id], onDelete: Cascade)

  // Child replies
  replies Reply[] @relation("ReplyThread")

  likes ReplyLike[]

  editedAt    DateTime?
  moderatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([commentId, createdAt])
  @@index([parentId, createdAt])
  @@index([authorId, createdAt])
  @@index([moderatedAt])
}

model CommentLike {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  commentId String
  comment   Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model ReplyLike {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  replyId String
  reply   Reply  @relation(fields: [replyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, replyId])
  @@index([replyId])
}

model MarketAsset {
  id            String  @id @default(cuid())
  symbol        String  @unique
  displaySymbol String?
  name          String
  category      String
  assetType     String  @default("index")
  timezone      String  @default("UTC")
  logoUrl       String?

  lastPrice     Decimal @default(0.0) @db.Decimal(18, 4)
  change        Decimal @default(0.0) @db.Decimal(18, 4)
  changePercent Decimal @default(0.0) @db.Decimal(10, 4)
  high          Decimal @default(0.0) @db.Decimal(18, 4)
  low           Decimal @default(0.0) @db.Decimal(18, 4)
  volume        Decimal @default(0.0) @db.Decimal(18, 2)

  watchlistItems Watchlist[]
  comments       CommentAsset[]
  predictions    Prediction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountBalance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  cash Decimal @default(10000.0) @db.Decimal(18, 2)
  pnl  Decimal @default(0.0) @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Watchlist {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  symbol String
  asset  MarketAsset @relation(fields: [symbol], references: [symbol], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, symbol])
}

enum NotificationType {
  PREDICTION_WON
  PREDICTION_LOST
  PREDICTION_DRAW
  PREDICTION_VOID
  PREDICTION_PENDING
}

model Notification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type NotificationType

  title   String
  message String

  predictionId String?

  prediction Prediction? @relation(fields: [predictionId], references: [id], onDelete: SetNull)

  eventKey String? @unique

  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([predictionId])
}

model PointBalance {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  points Int @default(10000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum PointTransactionType {
  BET
  WIN_PAYOUT
  DRAW_REFUND
  VOID_REFUND
}

model PointTransaction {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  predictionId String
  prediction   Prediction @relation(fields: [predictionId], references: [id], onDelete: Cascade)

  type   PointTransactionType
  amount Int

  createdAt DateTime @default(now())

  @@unique([predictionId, type])
  @@index([userId, createdAt])
  @@index([predictionId])
}
