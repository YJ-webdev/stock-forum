generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  
}

enum Role {
  USER
  ADMIN
}

enum TradeType {
  BUY
  SELL
}

enum TradeStatus {
  OPEN
  CLOSED
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  country       String?        
    language String @default("en")  
  role          Role            @default(USER)
  
  accounts      Account[]
  sessions      Session[]
  posts         Post[]
  comments      Comment[]
  likes         Like[]
  balance       AccountBalance?
  trades        Trade[]
  positions     PortfolioPosition[]
  watchlist     Watchlist[]
  predictions   Prediction[]

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Post {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  content   Json
  thumbnail String?

  viewCount Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User @relation(fields: [authorId], references: [id])

  assetSymbol String?
  asset       MarketAsset? @relation(fields: [assetSymbol], references: [symbol])

  comments Comment[]
  likes    Like[]

  @@index([authorId, createdAt])
  @@index([assetSymbol, createdAt])
}


model Comment {
  id        String   @id @default(cuid())
  content   String

  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([parentId])
}

model Like {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model MarketAsset {
  id            String  @id @default(cuid())
  symbol        String  @unique
  displaySymbol String?
  name          String
  category      String
  assetType     String  @default("index")
  timezone      String  @default("UTC")
  logoUrl       String?

  lastPrice     Decimal @default(0.0) @db.Decimal(18, 4)
  change        Decimal @default(0.0) @db.Decimal(18, 4)
  changePercent Decimal @default(0.0) @db.Decimal(10, 4)
  high          Decimal @default(0.0) @db.Decimal(18, 4)
  low           Decimal @default(0.0) @db.Decimal(18, 4)
  volume        Decimal @default(0.0) @db.Decimal(18, 2)

  trades        Trade[]
  positions     PortfolioPosition[]
  watchlistItems Watchlist[]

posts Post[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AccountBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  cash      Decimal  @default(10000.0) @db.Decimal(18, 2)
  pnl       Decimal  @default(0.0)     @db.Decimal(18, 2)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PortfolioPosition {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  symbol      String
  asset       MarketAsset @relation(fields: [symbol], references: [symbol])
  
  quantity    Decimal     @default(0.0) @db.Decimal(18, 8)
  avgCost     Decimal     @default(0.0) @db.Decimal(18, 4)

  updatedAt   DateTime    @updatedAt

  @@unique([userId, symbol])
}

model Trade {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  symbol     String
  asset      MarketAsset @relation(fields: [symbol], references: [symbol])
  
  type       TradeType
  status     TradeStatus @default(OPEN)
  
  quantity   Decimal     @db.Decimal(18, 8)
  entryPrice Decimal     @db.Decimal(18, 4)
  exitPrice  Decimal?    @db.Decimal(18, 4)
  pnl        Decimal?    @db.Decimal(18, 2)
  
  createdAt  DateTime    @default(now())
  closedAt   DateTime?

  @@index([userId, status])
}

model Watchlist {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  symbol    String
  asset     MarketAsset @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
  
  createdAt DateTime    @default(now())

  @@unique([userId, symbol])
}

enum PredictionDirection {
  BULL
  BEAR
}

enum PredictionStatus {
  PENDING
  WON
  LOST
  VOID
}

model Prediction {
  id        String @id @default(cuid())

  // User
  userId    String
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Market
  symbol        String
  displaySymbol String?
  assetName     String?

  // User's prediction
  direction PredictionDirection

  // Snapshot when prediction was made
  predictionPrice Decimal @db.Decimal(18, 4)

  // Market session being predicted
  sessionDate DateTime

  // Filled when the prediction is settled
  closingPrice Decimal?         @db.Decimal(18, 4)
  status       PredictionStatus @default(PENDING)

  // Points
  pointsChange Int?

  // Country at the time of prediction
  country String?

  createdAt DateTime @default(now())
  settledAt DateTime?

  // One prediction per user / asset / trading session
  @@unique([userId, symbol, sessionDate])

  @@index([symbol, sessionDate])
  @@index([userId, createdAt])
  @@index([country, symbol, sessionDate])
  @@index([status])
}